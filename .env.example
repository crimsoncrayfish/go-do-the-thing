# Go Do The Thing - Environment Configuration Example
# Copy this file to .env and update the values as needed

# Application Environment
# Options: development, production
# Default: development (if not set)
ENV=development

# Server Configuration
# Port for the HTTP server to listen on
# Default: 8080 (if not set)
PORT=8080

# Database Configuration
# For local development with `task db:up` (uses port 5433 to avoid conflicts):
DATABASE_URL=postgres://admin:admin@localhost:5433/todo_db?sslmode=disable

# For production, use a secure connection string:
# DATABASE_URL=postgres://username:password@host:port/database_name?sslmode=require

# JWT Authentication Keys (Required for production)
# Generate these using the commands in the README
# JWT_PRIVATE_KEY=<base64-encoded-private-key>
# JWT_PUBLIC_KEY=<base64-encoded-public-key>

# Rate Limiting Configuration
# Maximum requests per minute per IP address
# Default: 500 (if not set)
RATE_LIMIT_REQUESTS_PER_MINUTE=500

# Optional: Azure Integration
# AZURE_CLIENT_ID=<your-azure-client-id>

# Development Notes:
# - In development mode, DATABASE_URL defaults to: postgres://admin:admin@localhost:5432/todo_db?sslmode=disable
# - JWT keys are required for authentication to work properly
# - All commented variables are optional or have defaults