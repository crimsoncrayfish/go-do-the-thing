package templ_admin

import (
	"fmt"
	"go-do-the-thing/src/models"
)

templ UserTable(users []models.UserView) {
	<h2 class="text-xl font-bold mb-4 text-primary-dark dark:text-text-on-dark">
		Manage Users
	</h2>
	<div class="overflow-x-auto">
		<table class="min-w-full bg-primary-light dark:bg-primary-dark">
			<thead class="hidden md:table-header-group">
				<tr class="bg-secondary-light dark:bg-secondary-dark border-b border-border-light dark:border-border-dark">
					<th class="p-4 text-left uppercase text-sm font-semibold text-text-on-light dark:text-text-on-dark">
						Email
					</th>
					<th class="p-4 text-left uppercase text-sm font-semibold text-text-on-light dark:text-text-on-dark">
						Full Name
					</th>
					<th class="p-4 text-left uppercase text-sm font-semibold text-text-on-light dark:text-text-on-dark">
						Registration Date
					</th>
					<th class="p-4 text-left uppercase text-sm font-semibold text-text-on-light dark:text-text-on-dark">
						Action
					</th>
				</tr>
			</thead>
			<tbody id="user-rows">
				if len(users) == 0 {
					<tr>
						<td
							colspan="4"
							class="text-center p-6 text-text-on-light dark:text-text-on-dark border-b border-border-light dark:border-border-dark"
						>
							No users found.
						</td>
					</tr>
				} else {
					for _, user := range users {
						@UserRow(user)
					}
				}
			</tbody>
		</table>
	</div>
}

templ UserRow(user models.UserView) {
	// On mobile (default), this is a block. On medium screens+, it's a table-row.
	// This creates the "card" effect for each user on mobile.
	<tr
		id={ fmt.Sprintf("user-row-%d", user.Id) }
		class="block md:table-row mb-4 md:mb-0
							bg-secondary-light/50 dark:bg-secondary-dark/50
							md:even:bg-secondary-light md:dark:even:bg-secondary-dark
							md:hover:bg-accent-light md:dark:hover:bg-accent-dark
							text-text-on-light dark:text-text-on-dark
							md:hover:text-text-on-dark md:hover:dark:text-text-on-light
							md:dark:hover:text-primary-dark transition-colors duration-200
							border border-border-light dark:border-border-dark rounded-lg md:border-none md:rounded-none"
	>
		<td class="flex justify-between items-center p-3 md:p-4 border-b border-border-light/50 dark:border-border-dark/50 md:border-b-border-light dark:md:border-b-border-dark md:table-cell">
			<span class="font-semibold text-sm md:hidden">Email</span>
			<span>{ user.Email }</span>
		</td>
		<td class="flex justify-between items-center p-3 md:p-4 border-b border-border-light/50 dark:border-border-dark/50 md:border-b-border-light dark:md:border-b-border-dark md:table-cell">
			<span class="font-semibold text-sm md:hidden">Full Name</span>
			<span>{ user.FullName }</span>
		</td>
		<td class="flex justify-between items-center p-3 md:p-4 border-b border-border-light/50 dark:border-border-dark/50 md:border-b-border-light dark:md:border-b-border-dark md:table-cell">
			<span class="font-semibold text-sm md:hidden">Registered</span>
			<span>{ user.CreatedDate.Format("2006-01-02") }</span>
		</td>
		<td class="p-3 md:p-4 md:border-b border-border-light dark:border-border-dark md:table-cell">
			if !user.IsEnabled {
				<button
					class="w-full md:w-auto bg-success-light dark:bg-success-dark text-text-on-light dark:text-text-on-dark 
											px-4 py-2 rounded-md font-medium shadow-sm
											hover:bg-opacity-90 dark:hover:bg-opacity-90 transition-all duration-200
											focus:outline-none focus:ring-2 focus:ring-accent-light dark:focus:ring-accent-dark focus:ring-opacity-75"
					hx-post={ fmt.Sprintf("/admin/activate-user/%d", user.Id) }
					hx-target="closest tr"
					hx-swap="outerHTML"
				>
					Activate
				</button>
			} else {
				<button
					class="w-full md:w-auto bg-danger-light dark:bg-danger-dark text-text-on-light dark:text-text-on-dark 
											px-4 py-2 rounded-md font-medium shadow-sm
											hover:bg-opacity-90 dark:hover:bg-opacity-90 transition-all duration-200
											focus:outline-none focus:ring-2 focus:ring-accent-light dark:focus:ring-accent-dark focus:ring-opacity-75"
					hx-post={ fmt.Sprintf("/admin/deactivate-user/%d", user.Id) }
					hx-target="closest tr"
					hx-swap="outerHTML"
				>
					Deactivate
				</button>
			}
		</td>
	</tr>
}
