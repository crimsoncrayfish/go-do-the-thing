package templ_admin

import "go-do-the-thing/src/models"
import form_models "go-do-the-thing/src/models/forms"
import templ_shared "go-do-the-thing/src/shared/templ"
import "time"
import "strconv"

templ AnnouncementsDashboard(announcements []models.AnnouncementAdminView, form *form_models.AnnouncementForm) {
	<div class="space-y-6">
		<div class="flex justify-between items-center">
			<h2 class="text-2xl font-bold text-text-on-light dark:text-text-on-dark">Manage Announcements</h2>
		</div>
		
		<!-- Create New Announcement Form -->
		<div id="announcement-form-container" class="bg-secondary-light dark:bg-secondary-dark rounded-lg p-6">
			<div class="flex justify-between items-center mb-4">
				<h3 class="text-lg font-semibold text-text-on-light dark:text-text-on-dark">Create New Announcement</h3>
				<button
					onclick="toggleClassForId('hidden', 'announcement-form')"
					class="px-4 py-2 rounded-full border border-border-light dark:border-border-dark text-text-on-light dark:text-text-on-dark hover:bg-primary-light/10 dark:hover:bg-primary-dark/10 transition-colors shadow-md focus:outline-none focus:ring-2 focus:ring-accent-light dark:focus:ring-accent-dark focus:ring-opacity-50"
				>
					Toggle Form
				</button>
			</div>
			<form id="announcement-form" class="hidden" hx-post="/admin/announcements" hx-target="#announcements-list" hx-swap="outerHTML">
				<div class="space-y-4">
					<div>
						<label for="title" class="block text-sm font-medium text-text-on-light dark:text-text-on-dark mb-2">
							Announcement Text
						</label>
						<input
							type="text"
							id="title"
							name="title"
							value={ form.Title }
							placeholder="We've released a super awesome new feature..."
							class="w-full px-3 py-2 border border-border-light dark:border-border-dark rounded-md bg-primary-light dark:bg-primary-dark text-text-on-light dark:text-text-on-dark focus:outline-none focus:ring-2 focus:ring-primary-600"
							required
						/>
						if form.GetError("title") != "" {
							<p class="mt-1 text-sm text-red-600">{ form.GetError("title") }</p>
						}
					</div>
					<div>
						@templ_shared.FormDatePicker("Expires Date (defaults to 1 month from today)", "expires_date", "announcement-expires-date-picker", form.ExpiresDate)
						if form.GetError("expires_date") != "" {
							<p class="mt-1 text-sm text-red-600">{ form.GetError("expires_date") }</p>
						}
					</div>
					<div class="flex justify-end">
						<button
							type="submit"
							class="bg-success-light dark:bg-success-dark hover:opacity-80 text-white font-bold py-2 px-4 rounded-full shadow-md focus:outline-none focus:ring-2 focus:ring-success-dark focus:ring-opacity-50 flex items-center gap-2"
						>
							Create Announcement
						</button>
					</div>
				</div>
			</form>
		</div>

		<!-- Announcements List -->
		<div id="announcements-list">
			@AnnouncementsList(announcements)
		</div>
	</div>
}

templ AnnouncementsList(announcements []models.AnnouncementAdminView) {
	<div class="bg-secondary-light dark:bg-secondary-dark rounded-lg overflow-hidden">
		<div class="px-6 py-4 border-b border-border-light dark:border-border-dark">
			<h3 class="text-lg font-semibold text-text-on-light dark:text-text-on-dark">All Announcements</h3>
		</div>
		if len(announcements) == 0 {
			<div class="p-8 text-center text-text-on-light dark:text-text-on-dark">
				<div class="flex flex-col items-center space-y-3">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12 opacity-50">
						<path stroke-linecap="round" stroke-linejoin="round" d="M10.34 15.84c-.688-.06-1.386-.09-2.09-.09H7.5a4.5 4.5 0 110-9h.75c.704 0 1.402-.03 2.09-.09m0 9.18c.253.962.584 1.892.985 2.783.247.55.06 1.21-.463 1.511l-.657.38c-.551.318-1.26.117-1.527-.461a20.845 20.845 0 01-1.44-4.282m3.102.069a18.03 18.03 0 01-.59-4.59c0-1.586.205-3.124.59-4.59m0 9.18a23.848 23.848 0 018.835 2.535M10.34 6.66a23.847 23.847 0 008.835-2.535m0 0A23.74 23.74 0 0018.795 3m.38 1.125a23.91 23.91 0 011.014 5.395m-1.014 8.855c-.118.38-.245.754-.38 1.125m.38-1.125a23.91 23.91 0 001.014-5.395m0-3.46c.495.413.811 1.035.811 1.73 0 .695-.316 1.317-.811 1.73m0-3.46a24.347 24.347 0 010 3.46"></path>
					</svg>
					<div>
						<p class="text-lg font-medium">No announcements yet</p>
						<p class="text-sm opacity-75 mt-1">Create your first announcement to notify users about updates and news.</p>
					</div>
				</div>
			</div>
		} else {
			<div class="divide-y divide-border-light dark:divide-border-dark">
				for _, announcement := range announcements {
					@AnnouncementRow(announcement)
				}
			</div>
		}
	</div>
}

templ AnnouncementRow(announcement models.AnnouncementAdminView) {
	<div class="p-6 hover:bg-accent-light dark:hover:bg-accent-dark" id={ "announcement-" + strconv.FormatInt(announcement.Id, 10) }>
		<div class="flex justify-between items-start">
			<div class="flex-1">
				<div class="flex items-center space-x-3 mb-2">
					<h4 class="text-lg font-medium text-text-on-light dark:text-text-on-dark">
						{ announcement.Title }
					</h4>
					<div class="flex space-x-2">
						if announcement.IsActive && !announcement.IsDeleted && announcement.ExpiresDate != nil && announcement.ExpiresDate.After(time.Now()) {
							<span class="px-2 py-1 text-xs font-medium bg-green-100 text-green-800 rounded-full">Active</span>
						} else if announcement.ExpiresDate != nil && announcement.ExpiresDate.Before(time.Now()) {
							<span class="px-2 py-1 text-xs font-medium bg-yellow-100 text-yellow-800 rounded-full">Expired</span>
						} else if announcement.IsDeleted {
							<span class="px-2 py-1 text-xs font-medium bg-red-100 text-red-800 rounded-full">Deleted</span>
						} else {
							<span class="px-2 py-1 text-xs font-medium bg-gray-100 text-gray-800 rounded-full">Inactive</span>
						}
					</div>
				</div>
				<div class="text-sm text-text-on-light dark:text-text-on-dark opacity-75 space-y-1">
					<p>Created by: { announcement.CreatorName }</p>
					if announcement.CreatedDate != nil {
						<p>Created: { announcement.CreatedDate.Format("Jan 2, 2006 at 3:04 PM") }</p>
					}
					if announcement.ExpiresDate != nil {
						<p>Expires: { announcement.ExpiresDate.Format("Jan 2, 2006 at 3:04 PM") }</p>
					}
				</div>
			</div>
			<div class="flex space-x-2">
				if !announcement.IsDeleted {
					<button
						hx-delete={ "/admin/announcements/" + strconv.FormatInt(announcement.Id, 10) }
						hx-target="#announcements-list"
						hx-swap="outerHTML"
						hx-trigger="confirmed"
						onclick="showConfirmationDialog('Confirm Deletion', 'Are you sure you want to delete this announcement?', 'Delete', this)"
						class="bg-danger-light dark:bg-danger-dark hover:opacity-80 text-white font-bold py-2 px-4 rounded-full shadow-md focus:outline-none focus:ring-2 focus:ring-danger-dark focus:ring-opacity-50 flex items-center gap-2"
					>
						Delete
					</button>
				}
			</div>
		</div>
	</div>
}