{
  "name": "go-do-the-thing",
  "version": "1.0.0",
  "description": "todo app",
  "main": "index.js",
  "scripts": {
    "postinstall": "npm run copy-htmx",
    "copy-htmx": "cpx \"node_modules/htmx.org/dist/htmx.min.js\" static/js",
    "build": "npm run copy-htmx && tailwindcss build -i static/css/input.css -o static/css/tailwind.css --minify",
    "watch": "npm run copy-htmx && tailwindcss build -i static/css/input.css -o static/css/tailwind.css --watch"
  },
  "author": "TheCrayfish.dev",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/line-clamp": "^0.4.4",
    "cpx": "^1.5.0",
    "tailwind": "^4.0.0",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "htmx.org": "^2.0.1"
  }
}
